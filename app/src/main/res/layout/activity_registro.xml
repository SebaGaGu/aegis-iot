<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Nombre de la aplicacion -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AEGIS"
            android:textColor="#333333"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="28dp" />

        <!-- Titulo del registro -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear cuenta"
            android:textColor="#333333"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginBottom="26dp" />

        <!-- Correo electronico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etCorreoRegistro"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/borde_registro"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:imeOptions="actionNext"
            android:autofillHints="emailAddress"
            android:textColor="#333333"
            android:textSize="16sp" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textColor="#444444"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etContrasenaRegistro"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/borde_registro"
            android:padding="12dp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:imeOptions="actionNext"
            android:autofillHints="newPassword"
            android:textColor="#333333"
            android:textSize="16sp" />

        <!-- Confirmacion de contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Repetir contraseña"
            android:textColor="#444444"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etRepetirContrasena"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/borde_registro"
            android:padding="12dp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:autofillHints="newPassword"
            android:textColor="#333333"
            android:textSize="16sp" />

        <!-- Boton de crear cuenta -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="38dp"
            android:text="Crear cuenta"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textAllCaps="false"
            app:backgroundTint="#117D74"
            app:cornerRadius="4dp" />

        <!-- Volver al inicio de sesion -->
        <TextView
            android:id="@+id/tvIrLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="¿Ya tienes cuenta? Inicia sesión"
            android:textColor="#29A9E0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
