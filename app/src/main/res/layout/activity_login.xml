<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="28dp">

        <!-- Nombre de nuestra aplicacion centrado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AEGIS"
            android:textColor="#396CA8"
            android:textSize="38sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Linea decorativa del moodboard -->
        <View
            android:layout_width="75dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="#7A9C63"
            android:layout_marginBottom="40dp" />

        <!-- Titulo del inicio de sesion -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar sesión"
            android:textColor="#253D57"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="26dp" />

        <!-- Texto del correo electronico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textColor="#253D57"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="6dp" />

        <!-- Campo para introducir el correo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#578AB9"
            android:padding="1dp">

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:hint="Introduce tu correo"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:textColor="#253D57"
                android:textColorHint="#777777"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Texto de la contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textColor="#253D57"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp" />

        <!-- Campo para introducir la contraseña -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#578AB9"
            android:padding="1dp">

            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:hint="Introduce tu contraseña"
                android:inputType="textPassword"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:textColor="#253D57"
                android:textColorHint="#777777"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Boton azul principal para iniciar sesion -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:text="Iniciar sesión"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textAllCaps="false"
            app:backgroundTint="#396CA8"
            app:cornerRadius="28dp" />

        <!-- Botón azul claro para Google -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Continuar con Google"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false"
            app:backgroundTint="#578AB9"
            app:cornerRadius="28dp" />

        <!-- Boton verde para Facebook -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFacebook"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Continuar con Facebook"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false"
            app:backgroundTint="#59833D"
            app:cornerRadius="28dp" />

        <!-- Enlace para registrarse -->
        <TextView
            android:id="@+id/tvRegistrarse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="¿No tienes cuenta? Regístrate"
            android:textColor="#396CA8"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>
