<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Nombre de nuestra aplicación -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AEGIS"
            android:textColor="#396CA8"
            android:textSize="38sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp" />

        <!-- Línea verde del MoodBoard -->
        <View
            android:layout_width="75dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="#7A9C63"
            android:layout_marginBottom="42dp" />

        <!-- Título de la pantalla -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi cuenta"
            android:textColor="#253D57"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Tarjeta con los datos del usuario -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#F6F9FC"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#D4E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Apartado del nombre -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre de usuario"
                    android:textColor="#59833D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Aquí mostraremos el nombre de Firebase -->
                <TextView
                    android:id="@+id/tvNombreUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando usuario..."
                    android:textColor="#253D57"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

                <!-- Apartado del correo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico"
                    android:textColor="#59833D"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp" />

                <!-- Aquí mostraremos el correo de Firebase -->
                <TextView
                    android:id="@+id/tvCorreoUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando correo..."
                    android:textColor="#253D57"
                    android:textSize="16sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Título de conexión -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi maleta"
            android:textColor="#253D57"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="38dp"
            android:layout_marginBottom="14dp" />

        <!-- Estado de la maleta -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#F6F9FC"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#D4E2EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado de conexión"
                    android:textColor="#253D57"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Mostraremos el estado de la maleta -->
                <TextView
                    android:id="@+id/tvEstadoConexion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin conectar"
                    android:textColor="#59833D"
                    android:textSize="16sp"
                    android:layout_marginTop="10dp" />

                <!-- Botón para conectar la maleta -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConectarMaleta"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="Conectar maleta"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textAllCaps="false"
                    app:backgroundTint="#396CA8"
                    app:cornerRadius="28dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Botón para cerrar sesión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="24dp"
            android:text="Cerrar sesión"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textAllCaps="false"
            app:backgroundTint="#59833D"
            app:cornerRadius="28dp" />

    </LinearLayout>

</ScrollView>
